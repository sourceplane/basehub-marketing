# Copy to .env.local (git-ignored) for `next dev` and `pnpm build`.
#
# The BaseHub repository's read token (BaseHub → your repository → Connect →
# a read token). It is read at BUILD time and inlined into the server bundle
# (next.config.ts): a deployed build takes it from its environment's
# BASEHUB_TOKEN Orun secret (README → Connecting BaseHub). Unset, the site is
# unconnected: it renders its bundled sample content under a "connect BaseHub"
# notice, and the forms and analytics events do nothing.
BASEHUB_TOKEN=
# The site's origin, for the sitemap, robots and feeds. The deploy sets it per
# environment; locally it defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
